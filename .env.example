# ─── EMPIRE ATLAS environment template ───────────────────────────────────────
# Copy to .env.local for local development. Never commit real secrets.

# Database
# Leave DATABASE_URL empty to run on the embedded PGlite database stored in ./.data/pglite
# (zero-setup local development). Set it to a Postgres connection string (Supabase works)
# for shared/staging/production environments.
DATABASE_URL=

# Session signing secret. Required outside development. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ATLAS_SESSION_SECRET=

# Founding account (Researcher 001). Used only by `pnpm db:seed` and `pnpm atlas:create-user`.
# The seed creates this account with the Platform Owner role ONLY when both values are set.
# Public sign-up never grants elevated roles.
ATLAS_FOUNDER_EMAIL=
ATLAS_FOUNDER_PASSWORD=
ATLAS_FOUNDER_NAME=

# Public sign-up: "open" lets anyone create a Student account; "closed" allows admin-created accounts only.
ATLAS_SIGNUP_MODE=open

# Optional — AI Investment Historian (not wired in Phase 1). Keep server-side only.
ANTHROPIC_API_KEY=

# Optional — Supabase (planned adapter for Auth and private Storage; not required in Phase 1).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
